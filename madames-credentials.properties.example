# Madames Formosas — configuração do serviço do catálogo. Copie para madames-credentials.properties (NUNCA versionado).
# Em produção, use as variáveis de ambiente equivalentes (entre parênteses).

# Banco MySQL (DB_HOST / DB_USER / DB_PASSWORD). OBRIGATÓRIO: sem valor padrão, o serviço não sobe.
# O banco madames_formosas é criado se não existir, já com o catálogo inicial.
db.host=
db.user=
db.password=

# Token para criar/editar/excluir produtos em /madames/produtos, no header Authorization: Bearer <token>
# (MADAMES_ADMIN_TOKEN). Vazio = escrita desligada (503); a leitura pública continua funcionando.
# Gere: openssl rand -base64 32
madames.adminToken=

# Primeiro administrador da área da equipe (botão "Equipe" do site) — MADAMES_ADMIN_LOGIN / MADAMES_ADMIN_PASSWORD.
# Só é usado enquanto não existe ninguém cadastrado; depois, os vendedores são cadastrados pelo próprio site.
madames.adminLogin=
madames.adminPassword=

# Opcionais: porta e endereço do processo (MADAMES_PORT / MADAMES_HOST) — padrão 8082 em 127.0.0.1
# madames.port=8082
# madames.host=127.0.0.1
