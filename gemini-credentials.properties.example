# Gemini Live API — configuração local (dev)
# Copie este arquivo para gemini-credentials.properties (ignorado pelo git) e preencha.
# Nunca commite valores reais. Em produção (Heroku), configure via Config Vars:
#   heroku config:set GEMINI_API_KEY=sua_chave_aqui --app <nome-do-app>
gemini.apiKey=SUA_GEMINI_API_KEY

# Opcionais — chaves gratuitas, tentadas ANTES da paga acima (nessa ordem: free1, free2, paga).
# Se uma chave falhar antes de qualquer troca real de áudio (limite de uso, erro de conexão,
# etc), o servidor tenta a próxima automaticamente, sem o aluno perceber. Se não definir
# nenhuma das duas, só a chave paga é usada (comportamento de antes, sem fallback).
# gemini.apiKeyFree1=SUA_GEMINI_API_KEY_GRATUITA_1
# gemini.apiKeyFree2=SUA_GEMINI_API_KEY_GRATUITA_2

# Opcionais — só defina se precisar sobrepor os defaults do código:
# gemini.liveModel=models/gemini-2.0-flash-live-001
# gemini.liveVoice=Aoede
