# AWS Credentials Configuration
# Copie este arquivo para aws-credentials.properties (que é ignorado pelo git)
# e preencha com suas credenciais. Nunca commite valores reais.
# Alternativamente, defina como variáveis de ambiente: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, AWS_BUCKET_NAME
aws.accessKeyId=SEU_ACCESS_KEY_ID
aws.secretAccessKey=SEU_SECRET_ACCESS_KEY
aws.region=us-east-2
aws.bucketName=repo-english-class
